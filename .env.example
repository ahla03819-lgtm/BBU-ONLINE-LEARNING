APP_NAME="BBU ONLINE LEARNING"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edway_school
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Enable in every HTTPS production environment.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
MESSAGE_ATTACHMENT_DISK=local
MESSAGE_ATTACHMENT_ORPHAN_HOURS=24
MEETING_DEFAULT_MAX_PARTICIPANTS=50
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=edway-school
REVERB_APP_KEY=replace-with-local-key
REVERB_APP_SECRET=replace-with-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:8000
REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Meeting recording. Egress is a separate LiveKit service and must be deployed and
# enabled separately; recording fails closed while this is off.
LIVEKIT_EGRESS_ENABLED=false
LIVEKIT_EGRESS_API_URL=https://your-project.egress.livekit.cloud

# Where finished recordings live. RECORDING_DISK is an ordinary Laravel disk name.
# The output driver must agree with it: `local` writes to a filesystem this
# application shares with Egress (development, or a co-located self-hosted Egress),
# while `s3` has the provider upload to object storage, which is what LiveKit Cloud
# requires because its Egress worker is not on this host.
RECORDING_DISK=local
RECORDING_OUTPUT_DRIVER=local
RECORDING_PREFIX=meeting-recordings

# Object storage for recording. These credentials are handed to the Egress service so
# it can upload the finished object itself, and are therefore separate from the
# application's own AWS_* keys: give Egress a write-only credential scoped to a
# single prefix. Each falls back to the matching AWS_* value when left blank, so a
# single-purpose bucket needs no duplication. AWS_ENDPOINT covers Cloudflare R2 and
# MinIO; leave it blank for AWS S3.
RECORDING_EGRESS_S3_BUCKET=
RECORDING_EGRESS_S3_REGION=
RECORDING_EGRESS_S3_ENDPOINT=
RECORDING_EGRESS_S3_PATH_STYLE=false
RECORDING_EGRESS_S3_KEY=
RECORDING_EGRESS_S3_SECRET=
RECORDING_EGRESS_S3_SESSION_TOKEN=
